script = ExtResource("2_dialogue")
intro_text = "UNIT... you have awakened. Good. I feared the darkness had already taken everything"
followup_text = "I am Aldric. Or rather — what remains of me in these stones. The witch Morrga came without warning. She took my staff and scattered it across these floors."
quest_text = "I built you to protect this place. Now I need you to protect me. Find the four pieces of my staff. Restore it. Only then can the corruption be undone."
dialogue_font_size = 14
prompt_font_size = 12
dialogue_label_size = Vector2(360, 96)
dialogue_label_offset = Vector2(-180, -88)

